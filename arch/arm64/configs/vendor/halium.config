CONFIG_SYSVIPC=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
CONFIG_DEVTMPFS=y
CONFIG_BT_HCIVHCI=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_CMDLINE="cgroup_disable=pressure console=ttynull"
CONFIG_CMDLINE_EXTEND=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# Device specific
CONFIG_CGROUP_SCHED=y
# CONFIG_FAIR_GROUP_SCHED is not set
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_UCLAMP_TASK_GROUP=y
# CONFIG_KNOX_NCM is not set
CONFIG_BLK_DEV_LOOP_MIN_COUNT=32
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_QCOM_WCNSS_CTRL=y
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
CONFIG_FRAME_WARN=4096
CONFIG_DEBUG_FS=y
CONFIG_SEC_AUTO_INPUT=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECURITY_SMACK=y
CONFIG_SECURITY_TOMOYO=y
CONFIG_SECURITY_YAMA=y
CONFIG_EVM=y
CONFIG_CMA_ALIGNMENT=9
CONFIG_LOG_BUF_SHIFT=22
CONFIG_MSM_CDSP_LOADER=n
CONFIG_QCOM_CDSP_RM=n
CONFIG_SLUB_DEBUG=n
CONFIG_PM_DEBUG=n
CONFIG_PM_SLEEP_DEBUG=n
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=n
CONFIG_QCOM_KGSL_CONTEXT_DEBUG=n
CONFIG_MSM_GPI_DMA_DEBUG=n
CONFIG_SAMSUNG_LMKD_DEBUG=n
CONFIG_IOMMU_TLBSYNC_DEBUG=n
CONFIG_SEC_USER_RESET_DEBUG=n
CONFIG_KERNEL_MODE_NEON_DEBUG=n
CONFIG_CCIC_MAX77705_DEBUG=n
CONFIG_F2FS_SEC_BLOCK_OPERATIONS_DEBUG=n
CONFIG_NTFS_DEBUG=n
CONFIG_SCHED_DEBUG=n
